# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
.env.*.local

# Build output
frontend/dist/
backend/cdk.out/
backend/lib/*.js
backend/lib/*.d.ts
backend/bin/*.js
backend/bin/*.d.ts
# Compiled CDK test output (tsc emits alongside the .ts sources)
backend/test/*.js
backend/test/*.d.ts

# Generated Lambda layer deps — setup_backend.sh pip-installs boto3 here
backend/lambdas/shared/python/

# CDK deploy outputs (written then removed by setup scripts)
cdk-outputs.json
backend/cdk-outputs.json

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local security-review artifacts — kept out of the repo so the content
# scanner does not flag the justification doc for naming CVE identifiers, and
# so raw scan reports are never committed. Deliver these to reviewers directly.
docs/security-review.md
docs/scan-report*.json
