# ─── AgentCore Payments — Environment Template ───
# Copy this file to .env and fill in your values.
# Most values are auto-populated by `npm run setup:backend`.

# AWS (auto-detected if blank)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# AgentCore control-plane and data-plane endpoints are resolved from
# AWS_REGION by boto3 — no overrides needed. The agent WebSocket/invoke
# lambda uses the AgentCore Runtime endpoint, which setup:backend
# auto-populates from AWS_REGION when left blank (e.g.
# https://bedrock-agentcore.<AWS_REGION>.amazonaws.com). Set a value only
# to override it.
RUNTIME_ENDPOINT=

# ─── CDK Stack Outputs (auto-injected by setup:backend) ───
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
API_URL=
PAYMENT_MANAGER_ROLE_ARN=
MEMORY_ID=
SELLER_API_URL=

# ─── Seller Payout Wallet ───
# The seller's payout wallet (EVM + Solana) is provisioned at runtime by
# AgentCore Payments from the admin Seller Setup page, not set here. Every paid
# endpoint (storefront orders AND the image-gen seller) resolves its payout
# address from that single provisioned identity, so there are no seller wallet
# addresses to configure in this file.

# x402 networks
USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_FACILITATOR_URL=https://x402.org/facilitator

# Solana Devnet
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Models — Claude Sonnet 4.6 powers the storefront buying agent (text + tool use)
TEXT_MODEL_ID=us.anthropic.claude-sonnet-4-6
VOICE_MODEL_ID=amazon.nova-2-sonic-v1:0

# Observability — wire AgentCore Payments vended log delivery (Payments
# transaction logs → CloudWatch Logs /bedrock-agentcore/payments/<managerId>).
# Set to 0 to disable. ADOT tracing/metrics run regardless.
ENABLE_VENDED_LOG_DELIVERY=1
# Payments plugin is the primary x402 path (auto 402 → ProcessPayment → retry)
# and tags spans with PAYMENTS_AGENT_NAME, which populates the Payments
# observability dashboard counters (Agents / Managers / Connectors). Set to 0
# to fall back to the in-process x402 path inside the paid tools.
ENABLE_PAYMENTS_PLUGIN=1
PAYMENTS_AGENT_NAME=agentcore-payments-agent

# ─── Storefront delivery (optional) ───
# Physical-order confirmation emails are sent via Amazon SES. Leave blank to run
# the sample with zero email setup: orders still complete and the confirmation
# is returned as a preview instead of an email. To send real email, verify this
# address in SES (one click on the SES verification email). In the SES sandbox
# the recipient must also be verified — for a single-operator demo, use the same
# address for both, the same way you verify an email for a payment instrument.
STORE_FROM_EMAIL=
# Signing secret for digital license redeem tokens. Leave blank: the lambda
# falls back to a per-process random secret (tokens are signed-only). Set a
# fixed value here only if you want license tokens to remain valid across
# lambda cold starts and redeploys.
LICENSE_SIGNING_SECRET=

# ─── Frontend (Vite — auto-injected by setup:backend) ───
VITE_API_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
VITE_SOLANA_DEVNET_RPC=https://api.devnet.solana.com
VITE_SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ─── Amplify (auto-injected by setup:amplify) ───
# AMPLIFY_APP_ID=  # Set automatically — used by cleanup to delete the correct app

# ─── FSI Research Site (auto-injected by setup:backend) ───
# ─── Agent-Economy Storefront (auto-injected by setup:backend) ───
# STOREFRONT_API_URL=  # API Gateway URL for products + x402 order endpoint
# STOREFRONT_URL=      # CloudFront URL for the static storefront catalog

# ─── Privy Embedded Wallets (Frontend SDK) ───
# Required for the "Connect Agent" flow on Privy-backed instruments — the
# frontend signs into Privy and calls addSessionSigners to attach the
# AgentCore authorization-key quorum to the wallet. Without these, Privy
# instruments are created but the agent can't sign for them.
#
# Both values are public. Paste them from the Privy Dashboard — the same
# dashboard where admins later fill in the matching secrets via the
# Credential Providers admin page.
#
# VITE_PRIVY_APP_ID      — Privy Dashboard → Developer App → App ID
# VITE_PRIVY_SIGNER_ID   — Privy Dashboard → Wallet infrastructure →
#                          Authorization keys → the key ID (safe to expose)
#
# IMPORTANT: VITE_PRIVY_SIGNER_ID must be the SAME authorization key whose
# private key you paste as the Credential Provider's "Authorization Private
# Key" in the admin UI — i.e. the credential provider's Authorization Key ID
# must equal VITE_PRIVY_SIGNER_ID. If they are different keys, the agent signs
# with a key your wallet never delegated to and ProcessPayment fails at
# signing time.
VITE_PRIVY_APP_ID=
VITE_PRIVY_SIGNER_ID=
